MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/certiverxia?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET
CREDENTIAL_KEY_ENCRYPTION_SECRET=REPLACE_WITH_EXISTING_SIGNING_KEY_ENCRYPTION_SECRET
VERIFICATION_PRIVACY_SECRET=REPLACE_WITH_EXISTING_PRIVACY_SECRET
JWT_ACCESS_TOKEN_TTL=15m
SAAS_ENABLED=true
OUTBOUND_DELIVERY_MODE=disabled
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=info@certiverxia.com
EMAIL_PASS=REPLACE_WITH_HOSTINGER_MAILBOX_PASSWORD
EMAIL_FROM_NAME=Certiverxia
BACKUP_DIRECTORY=/usr/src/app/backups
VERIFICATION_LOG_RETENTION_DAYS=180
SHARE_RECORD_RETENTION_DAYS=30
# Existing databases already contain the administrator. Do not bootstrap another one.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
