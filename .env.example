# Backend
PORT=5000
NODE_ENV=development
SAAS_ENABLED=false
VITE_SAAS_ENABLED=false
# Required when NODE_ENV=production: staging or production.
# DEPLOYMENT_ENV=staging
OUTBOUND_DELIVERY_MODE=disabled
STAGING_EMAIL_ALLOWLIST=
STAGING_SMS_ALLOWLIST=
MONGODB_URI=mongodb://localhost:27017/certverify
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# A separate random secret used to encrypt institute credential-signing keys.
# Generate at least 32 random bytes and store it only in the backend environment.
CREDENTIAL_KEY_ENCRYPTION_SECRET=replace-with-a-different-random-32-byte-secret
VERIFICATION_PRIVACY_SECRET=replace-with-another-distinct-random-32-byte-secret
JWT_ACCESS_TOKEN_TTL=15m
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Set to the exact number of trusted reverse proxies in production. Leave empty for direct local development.
TRUST_PROXY=1
VERIFICATION_LOG_RETENTION_DAYS=180
SHARE_RECORD_RETENTION_DAYS=30
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=60
VERIFY_RATE_LIMIT_WINDOW_MS=900000
VERIFY_RATE_LIMIT_MAX=120
SHARE_RATE_LIMIT_WINDOW_MS=900000
SHARE_RATE_LIMIT_MAX=30
JSON_BODY_LIMIT=2mb
BACKUP_DIRECTORY=./backups
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
TEXTLK_SMS_ENDPOINT=https://app.text.lk/api/v3/sms/send
TEXTLK_API_TOKEN=your-textlk-api-token
TEXTLK_SENDER_ID=CVS
TEXTLK_AUTH_PREFIX=Bearer

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
