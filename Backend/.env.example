PORT=5000
SAAS_ENABLED=false
# Optional initial bank instructions; saved super-admin settings take precedence.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_BANK_BRANCH=
# Set DEPLOYMENT_ENV=staging or production when NODE_ENV=production.
# Staging delivery defaults to disabled; enable only allowlisted test recipients.
OUTBOUND_DELIVERY_MODE=disabled
STAGING_EMAIL_ALLOWLIST=
STAGING_SMS_ALLOWLIST=
MONGODB_URI=mongodb://localhost:27017/certverify
JWT_SECRET=change-this-secret
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Comma-separated HTTPS host aliases that must redirect to FRONTEND_URL in deployment checks.
# Production Certiverxia uses www.certiverxia.com; leave empty for local development.
PUBLIC_DOMAIN_ALIASES=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_ACCESS_TOKEN_TTL=15m
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-admin-password
SUPERADMIN_NAME=System Administrator

EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password

# Text.lk SMS OTP: inject these into the backend service in Dokploy too.
# Use a current private API token and an approved sender ID (not TextLKDemo).
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
TEXTLK_SMS_ENDPOINT=https://app.text.lk/api/v3/sms/send
TEXTLK_AUTH_PREFIX=Bearer
TEXTLK_TIMEOUT_MS=10000
