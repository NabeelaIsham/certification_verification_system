Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve real assets directly and route client-side URLs such as /share/:token
# and /verify/:code through the React application.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
